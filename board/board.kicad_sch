	(text "Serial1 USB: application UART2 only.\nProgramming uses external J4 UART0."
		(exclude_from_sim no)
		(at 26.67 151.13 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "0120aab3-df3a-4b3b-bdba-a57768f947e7")
	)
	(text "J4: 1=+3V3, 2=GND, 3=ESP TXD0, 4=ESP RXD0, 5=EN, 6=GPIO0.\nProgramming: Serial1 USB disconnected; programmer powers J4 pin1 at regulated 3.3 V.\nNormal use: disconnect the programmer completely, then connect Serial1 USB.\nU3 OUT and J4 pin1 share +3V3 directly; no reverse-current isolation.\nAdapter TX -> RXD0, RX <- TXD0; common GND; 3.3 V logic only."
		(exclude_from_sim no)
		(at 238.76 55 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "4b7f4245-86d9-4d15-9965-8e2c392f62b4")
	)
	(text "EXTERNAL ESP32 UART0 PROGRAMMING / 3.3 V LOGIC ONLY"
		(exclude_from_sim no)
		(at 238.76 30.48 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "68734e77-3545-454e-bab0-99c934744027")
	)
	(text "U3: TI TLV1117LV33DCYR (pin-compatible 1117 symbol).\nKeep this ceramic-stable regulator with MLCC output capacitor C5.\nC5: 22uF 25V X5R Basic; account for DC-bias derating."
		(exclude_from_sim no)
		(at 142.24 170.18 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "9d38b3f0-ec4c-4b10-815b-94d8668bc93b")
	)
	(text "Manual download via J4: connect pin6 (GPIO0) to pin2 (GND).\nBriefly connect pin5 (EN) to GND, then release EN with GPIO0 still low.\nFlash via UART0; release GPIO0 and pulse EN again for normal boot.\nR5/R6 pull-ups and C6 (1uF EN-to-GND) provide bias and reset timing.\nNo on-board DTR/RTS auto-reset circuit."
		(exclude_from_sim no)
		(at 238.76 209.55 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "bdfc6b6d-fe6d-47e5-aa40-c56df944b6c0")
	)
